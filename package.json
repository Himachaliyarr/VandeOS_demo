{
  "name": "vande-os-phase1",
  "version": "1.0.0",
  "private": true,
  "description": "Vande OS Phase 1 — MERN workforce and HR foundation",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start": "npm --prefix server run start",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server run test",
    "check": "npm --prefix server run check && npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": { "node": ">=20.19.0" }
}
